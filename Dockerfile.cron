# Dockerfile for scheduled cron jobs
FROM python:3.11-slim

WORKDIR /app

# Install cron and dependencies
RUN apt-get update && apt-get install -y \
    cron \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project
COPY . .

# Set Python path
ENV PYTHONPATH=/app:/app/script

# Create log directory
RUN mkdir -p /app/logs

# Create cron job file with both schedules
RUN echo "# Council Cron Jobs" > /etc/cron.d/council-cron \
    && echo "" >> /etc/cron.d/council-cron \
    && echo "# ============================================" >> /etc/cron.d/council-cron \
    && echo "# cron_feeds.py - Runs every 12 hours" >> /etc/cron.d/council-cron \
    && echo "# ============================================" >> /etc/cron.d/council-cron \
    && echo "0 */12 * * * root cd /app && /usr/local/bin/python script/automation/cron_feeds.py >> /app/logs/cron_feeds.log 2>&1" >> /etc/cron.d/council-cron \
    && echo "" >> /etc/cron.d/council-cron \
    && echo "# ============================================" >> /etc/cron.d/council-cron \
    && echo "# councilor_cron.py - Runs on 15th of every month at midnight" >> /etc/cron.d/council-cron \
    && echo "# ============================================" >> /etc/cron.d/council-cron \
    && echo "0 0 15 * * root cd /app && /usr/local/bin/python script/automation/councilor_cron.py >> /app/logs/councilor_cron.log 2>&1" >> /etc/cron.d/council-cron \
    && echo "" >> /etc/cron.d/council-cron \
    && chmod 0644 /etc/cron.d/council-cron \
    && crontab /etc/cron.d/council-cron

# Create log files
RUN touch /app/logs/councilor_cron.log /app/logs/cron_feeds.log
# Start cron in foreground
CMD ["cron", "-f"]